<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AquaAlerte.Views.SignalementEnvoyePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AquaBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28">

            <!-- En-tête : flèche + titre -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                    <Image Source="ic_arrow_left_dark.svg" WidthRequest="26" HeightRequest="26"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Label Grid.Column="1" Text="Signalement envoyé" Style="{StaticResource PageTitle}"
                       FontSize="28" VerticalOptions="Center" />
            </Grid>

            <!-- Pastille de réussite -->
            <Border WidthRequest="88" HeightRequest="88" StrokeShape="Ellipse" StrokeThickness="0"
                    BackgroundColor="#E6F4EC" Padding="0" HorizontalOptions="Center" Margin="0,28,0,0">
                <Image Source="ic_check_thin_green.svg" WidthRequest="44" HeightRequest="44" />
            </Border>

            <Label Text="Merci pour vos voisins." FontSize="30" FontAttributes="Bold"
                   TextColor="{StaticResource AquaText}" HorizontalTextAlignment="Center"
                   Margin="0,24,0,0" />
            <Label Text="Votre signalement est publié. La communauté peut maintenant le confirmer et suivre son évolution."
                   FontSize="17" TextColor="{StaticResource AquaMuted}"
                   HorizontalTextAlignment="Center" Margin="8,12,8,0" />

            <!-- Carte du signalement -->
            <Border StrokeShape="RoundRectangle 18" Stroke="{StaticResource AquaBorder}" StrokeThickness="1"
                    BackgroundColor="White" Padding="18" Margin="0,26,0,0">
                <VerticalStackLayout Spacing="10">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HorizontalOptions="Start"
                            BackgroundColor="#FDECEC" Padding="12,7">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_error_red.svg" WidthRequest="18" HeightRequest="18"
                                   VerticalOptions="Center" />
                            <Label Text="En cours" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource AquaError}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource AquaText}" />
                    <Label x:Name="StartLabel" FontSize="16" TextColor="{StaticResource AquaMuted}" />
                    <Label x:Name="PublishedLabel" FontSize="13" TextColor="{StaticResource AquaMuted}"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Suivre cette coupure -->
            <Border StrokeShape="RoundRectangle 18" Stroke="{StaticResource AquaBorder}" StrokeThickness="1"
                    BackgroundColor="White" Padding="18,14" Margin="0,16,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Suivre cette coupure" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource AquaText}" />
                        <Label Text="Recevoir les observations et le retour de l’eau." FontSize="14"
                               TextColor="{StaticResource AquaMuted}" />
                    </VerticalStackLayout>
                    <Switch x:Name="FollowSwitch" Grid.Column="1" IsToggled="True"
                            OnColor="{StaticResource AquaPrimary}" ThumbColor="White"
                            VerticalOptions="Center" Toggled="OnFollowToggled" />
                </Grid>
            </Border>

            <!-- Boutons -->
            <Button Text="Voir mon signalement" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" Clicked="OnSeeClicked" />
            <Button Text="Retour au quartier" BackgroundColor="White"
                    BorderColor="{StaticResource AquaBorder}" BorderWidth="1"
                    TextColor="{StaticResource AquaPrimary}" FontSize="16" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="14" Margin="0,12,0,0"
                    Clicked="OnBackToQuartierClicked" />

            <!-- Encadré d'information -->
            <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border WidthRequest="18" HeightRequest="18" StrokeShape="Ellipse" Padding="0"
                            Stroke="{StaticResource AquaPrimary}" StrokeThickness="1.5"
                            BackgroundColor="Transparent" VerticalOptions="Start" Margin="0,2,0,0">
                        <Label Text="i" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource AquaPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" FontSize="15" TextColor="{StaticResource AquaText}"
                           Text="Un signalement communautaire n’est pas une information officielle du fournisseur d’eau." />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>