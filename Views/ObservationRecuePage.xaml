<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AquaAlerte.Views.ObservationRecuePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AquaBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28">

            <!-- En-tête : flèche + titre -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                    <Image Source="ic_arrow_left_dark.svg" WidthRequest="26" HeightRequest="26"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Label Grid.Column="1" Text="Observation reçue" Style="{StaticResource PageTitle}"
                       FontSize="28" VerticalOptions="Center" />
            </Grid>

            <!-- Pastille -->
            <Border WidthRequest="88" HeightRequest="88" StrokeShape="Ellipse" StrokeThickness="0"
                    BackgroundColor="#E3F3F8" Padding="0" HorizontalOptions="Center" Margin="0,28,0,0">
                <Image Source="ic_users_big.svg" WidthRequest="44" HeightRequest="44" />
            </Border>

            <Label Text="Votre voix compte." FontSize="30" FontAttributes="Bold"
                   TextColor="{StaticResource AquaText}" HorizontalTextAlignment="Center"
                   Margin="0,24,0,0" />
            <Label Text="Vous confirmez que l’eau est toujours coupée chez vous. Merci de garder votre quartier informé."
                   FontSize="17" TextColor="{StaticResource AquaMuted}"
                   HorizontalTextAlignment="Center" Margin="8,12,8,0" />

            <!-- Carte -->
            <Border StrokeShape="RoundRectangle 18" Stroke="{StaticResource AquaBorder}" StrokeThickness="1"
                    BackgroundColor="White" Padding="18" Margin="0,26,0,0">
                <VerticalStackLayout Spacing="10">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" HorizontalOptions="Start"
                            BackgroundColor="#FDECEC" Padding="12,7">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_error_red.svg" WidthRequest="18" HeightRequest="18"
                                   VerticalOptions="Center" />
                            <Label Text="En cours" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource AquaError}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource AquaText}" />
                    <Label x:Name="ConfLabel" FontSize="16" TextColor="{StaticResource AquaText}" />
                    <Label x:Name="MyObsLabel" FontSize="14" TextColor="{StaticResource AquaMuted}"
                           Margin="0,4,0,0" />
                    <Label x:Name="StartLabel" FontSize="14" TextColor="{StaticResource AquaMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Encadré -->
            <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border WidthRequest="18" HeightRequest="18" StrokeShape="Ellipse" Padding="0"
                            Stroke="{StaticResource AquaPrimary}" StrokeThickness="1.5"
                            BackgroundColor="Transparent" VerticalOptions="Start" Margin="0,2,0,0">
                        <Label Text="i" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource AquaPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Le statut reste « En cours »" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource AquaText}" />
                        <Label Text="Votre confirmation décrit la situation chez vous, sans indiquer une heure de retour."
                               FontSize="15" TextColor="{StaticResource AquaText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Boutons -->
            <Button Text="Revenir à la coupure" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" Clicked="OnBackToReportClicked" />
            <Button Text="Retour au quartier" BackgroundColor="White"
                    BorderColor="{StaticResource AquaBorder}" BorderWidth="1"
                    TextColor="{StaticResource AquaPrimary}" FontSize="16" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="14" Margin="0,12,0,0"
                    Clicked="OnBackToQuartierClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>