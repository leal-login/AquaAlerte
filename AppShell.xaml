<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AquaAlerte.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AquaAlerte.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="AquaAlerte">

    <ShellContent ContentTemplate="{DataTemplate views:OnboardingPage}" Route="OnboardingPage" />
    <ShellContent ContentTemplate="{DataTemplate views:BienvenuePage}" Route="BienvenuePage" />
    <ShellContent ContentTemplate="{DataTemplate views:AccueilPage}" Route="AccueilPage" />
    <ShellContent ContentTemplate="{DataTemplate views:CartePage}" Route="CartePage" />
    <ShellContent ContentTemplate="{DataTemplate views:AlertesPage}" Route="AlertesPage" />
    <ShellContent ContentTemplate="{DataTemplate views:ProfilPage}" Route="ProfilPage" />

</Shell>