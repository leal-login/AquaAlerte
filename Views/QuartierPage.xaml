<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AquaAlerte.Models"
             x:Class="AquaAlerte.Views.QuartierPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AquaBg}">

    <!-- 2 lignes : contenu qui défile + bouton fixe en bas -->
    <Grid RowDefinitions="*,Auto" Padding="20,16,20,16">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout>

                <!-- En-tête : flèche retour + titre -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                        <Image Source="ic_arrow_left_dark.svg" WidthRequest="26" HeightRequest="26"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Label Grid.Column="1" Text="Votre quartier" Style="{StaticResource PageTitle}"
                           FontSize="28" VerticalOptions="Center" />
                </Grid>
                <Label Text="Des informations utiles, près de chez vous."
                       Style="{StaticResource PageSubtitle}" FontSize="15" Margin="4,4,0,0" />

                <!-- Carte « position » -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource AquaBorder}"
                        StrokeThickness="1" BackgroundColor="White" Padding="16" Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Image Source="ic_target_teal.svg" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Vous êtes à Douala ?" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource AquaText}" />
                                <Label Text="Retrouvez les quartiers proches avec votre position."
                                       FontSize="15" TextColor="{StaticResource AquaMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="Utiliser ma position" ImageSource="ic_navigation_white.svg"
                                ContentLayout="Left,10" Style="{StaticResource PrimaryButton}"
                                Clicked="OnUsePositionClicked" />
                        <Label Text="Facultatif. Votre position précise n’est pas publiée."
                               FontSize="13" TextColor="{StaticResource AquaMuted}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="OU CHOISIR MANUELLEMENT" FontSize="13" FontAttributes="Bold"
                       CharacterSpacing="0.5" TextColor="{StaticResource AquaMuted}"
                       HorizontalOptions="Center" Margin="0,22,0,0" />

                <!-- Ville -->
                <Label Text="Ville" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"
                        Stroke="{StaticResource AquaPrimary}" StrokeThickness="1.5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker x:Name="CityPicker" BackgroundColor="Transparent" FontSize="16"
                                TextColor="{StaticResource AquaText}" VerticalOptions="Center"
                                SelectedIndexChanged="OnCityChanged" />
                        <Image Grid.Column="1" Source="ic_chevron_down.svg" WidthRequest="22"
                               HeightRequest="22" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                </Border>

                <!-- Recherche -->
                <Label Text="Rechercher un quartier" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="SearchEntry" Placeholder="Ex. Akwa"
                               TextChanged="OnSearchChanged" Style="{StaticResource FieldEntry}" />
                        <Image Grid.Column="1" Source="ic_search_teal.svg" WidthRequest="22"
                               HeightRequest="22" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Liste des quartiers -->
                <VerticalStackLayout x:Name="QuartierLayout" Spacing="12" Margin="0,16,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:QuartierItem">
                            <Border Style="{StaticResource FieldBox}" HeightRequest="72">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AquaPrimary}" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource AquaInfoBg}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnItemTapped" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Image Source="ic_pin_teal.svg" WidthRequest="22" HeightRequest="22"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold"
                                               TextColor="{StaticResource AquaText}" />
                                        <Label Text="{Binding Ville}" FontSize="14"
                                               TextColor="{StaticResource AquaMuted}" />
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2" Source="ic_radio_empty.svg" WidthRequest="26"
                                           HeightRequest="26" VerticalOptions="Center">
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Source" Value="ic_check_circle_teal.svg" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label x:Name="EmptyLabel" Text="Aucun quartier trouvé." FontSize="15"
                       TextColor="{StaticResource AquaMuted}" HorizontalOptions="Center"
                       IsVisible="False" Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bouton fixe en bas -->
        <Button x:Name="ContinueButton" Grid.Row="1" Text="Continuer"
                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                Clicked="OnContinueClicked" />
    </Grid>
</ContentPage>