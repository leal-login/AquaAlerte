<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AquaAlerte.Views"
             x:Class="AquaAlerte.Views.CartePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AquaBg}">

    <Grid RowDefinitions="*,Auto">

        <!-- Contenu : en-tête, carte (qui s'étire), fiche du bas -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto">

            <!-- En-tête -->
            <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Autour de vous" Style="{StaticResource PageTitle}" FontSize="30" />
                    <Image Grid.Column="1" Source="ic_drop_teal.svg" WidthRequest="26"
                           HeightRequest="26" VerticalOptions="Center" />
                </Grid>

                <!-- Sélecteur de quartier -->
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0"
                        BackgroundColor="{StaticResource AquaInfoBg}" Padding="16,12" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image Source="ic_pin_teal.svg" WidthRequest="26" HeightRequest="26"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label x:Name="QuartierLabel" Text="Akwa" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource AquaText}" />
                            <Label x:Name="VilleLabel" Text="Douala · Cameroun" FontSize="15"
                                   TextColor="{StaticResource AquaText}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="ic_chevron_down.svg" WidthRequest="24"
                               HeightRequest="24" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChangeQuartierTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Filtres -->
                <HorizontalStackLayout Spacing="10" Margin="0,14,0,0">
                    <Border x:Name="ChipAll" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,10">
                        <Label x:Name="ChipAllLabel" Text="Toutes" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="all" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="ChipOngoing" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,10">
                        <Label x:Name="ChipOngoingLabel" Text="En cours" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="encours" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="ChipRestored" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,10">
                        <Label x:Name="ChipRestoredLabel" Text="Eau revenue" FontSize="15" FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="revenue" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- La vraie carte (Leaflet + OpenStreetMap) -->
            <WebView x:Name="MapView" Grid.Row="1"
                     Navigating="OnMapNavigating" Navigated="OnMapNavigated" />

            <!-- Fiche de la coupure choisie -->
            <Border Grid.Row="2" StrokeShape="RoundRectangle 24,24,0,0" StrokeThickness="0"
                    BackgroundColor="White" Padding="20,10,20,16">
                <VerticalStackLayout Spacing="10">
                    <BoxView WidthRequest="44" HeightRequest="5" CornerRadius="3"
                             Color="{StaticResource AquaBorder}" HorizontalOptions="Center" />

                    <Label x:Name="EmptySheetLabel" Text="Touchez un repère sur la carte pour voir les détails."
                           FontSize="15" TextColor="{StaticResource AquaMuted}" IsVisible="False" />

                    <VerticalStackLayout x:Name="SheetContent" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="SheetBadgeBox" StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0" Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Image x:Name="SheetBadgeIcon" WidthRequest="18" HeightRequest="18"
                                           VerticalOptions="Center" />
                                    <Label x:Name="SheetBadgeLabel" FontSize="14" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label x:Name="SheetConfLabel" Grid.Column="1" FontSize="14"
                                   TextColor="{StaticResource AquaMuted}"
                                   HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <Label x:Name="SheetTitle" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource AquaText}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label x:Name="SheetSub" FontSize="15" TextColor="{StaticResource AquaMuted}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Voir le détail" Style="{StaticResource LinkLabel}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSeeDetailTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <HorizontalStackLayout Spacing="8">
                            <Image Source="ic_clock_gray.svg" WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" />
                            <Label x:Name="SheetSince" FontSize="16" TextColor="{StaticResource AquaText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button x:Name="ConfirmButton" Text="Je constate aussi la coupure"
                                Style="{StaticResource PrimaryButton}" Margin="0,4,0,0"
                                Clicked="OnConfirmClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <views:BottomNavBar Grid.Row="1" Active="CartePage" />
    </Grid>
</ContentPage>