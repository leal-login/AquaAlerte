<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AquaAlerte.Views"
             x:Class="AquaAlerte.Views.CartePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#D0DAE3">

    <Grid RowDefinitions="*,Auto">

        <ScrollView>
            <VerticalStackLayout>

                <VerticalStackLayout Padding="20,16,20,0">

                    <!-- Titre -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Autour de vous" Style="{StaticResource PageTitle}" FontSize="30" />
                        <Image Grid.Column="1" Source="ic_drop_teal.svg" WidthRequest="26"
                               HeightRequest="26" VerticalOptions="Center" />
                    </Grid>

                    <!-- Sélecteur de quartier -->
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0"
                            BackgroundColor="{StaticResource AquaInfoBg}" Padding="16,14" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Image Source="ic_pin_teal.svg" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="QuartierLabel" Text="Akwa" FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource AquaText}" />
                                <Label x:Name="VilleLabel" Text="Douala · Cameroun" FontSize="15"
                                       TextColor="{StaticResource AquaText}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="ic_chevron_down.svg" WidthRequest="24"
                                   HeightRequest="24" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeQuartierTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Filtres -->
                    <HorizontalStackLayout Spacing="10" Margin="0,16,0,0">
                        <Border x:Name="ChipAll" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,11">
                            <Label x:Name="ChipAllLabel" Text="Toutes" FontSize="15" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="all" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="ChipOngoing" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,11">
                            <Label x:Name="ChipOngoingLabel" Text="En cours" FontSize="15" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="encours" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="ChipRestored" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="20,11">
                            <Label x:Name="ChipRestoredLabel" Text="Eau revenue" FontSize="15" FontAttributes="Bold" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="revenue" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- La carte -->
                    <Border StrokeShape="RoundRectangle 24" StrokeThickness="0"
                            HeightRequest="300" Margin="0,16,0,0">
                        <Grid>
                            <Image Source="carte_akwa.svg" Aspect="AspectFill" />

                            <!-- Couche des étiquettes, boutons et repères -->
                            <AbsoluteLayout x:Name="MapLayer">

                                <Label Text="Bessengue" FontSize="12" TextColor="#4A5A68"
                                       AbsoluteLayout.LayoutBounds="0.73,0.02,AutoSize,AutoSize"
                                       AbsoluteLayout.LayoutFlags="PositionProportional" />
                                <Label Text="Boulevard de la Liberté" FontSize="12" TextColor="#4A5A68"
                                       AbsoluteLayout.LayoutBounds="0.05,0.28,AutoSize,AutoSize"
                                       AbsoluteLayout.LayoutFlags="PositionProportional" />
                                <Label Text="AKWA" FontSize="15" FontAttributes="Bold" TextColor="#1F4B5F"
                                       AbsoluteLayout.LayoutBounds="0.73,0.44,AutoSize,AutoSize"
                                       AbsoluteLayout.LayoutFlags="PositionProportional" />
                                <Label Text="Rue Joss" FontSize="12" TextColor="#4A5A68"
                                       AbsoluteLayout.LayoutBounds="0.02,0.89,AutoSize,AutoSize"
                                       AbsoluteLayout.LayoutFlags="PositionProportional" />
                                <Label Text="Carte schématique · positions approximatives" FontSize="11"
                                       TextColor="{StaticResource AquaMuted}"
                                       AbsoluteLayout.LayoutBounds="0.03,0.99,AutoSize,AutoSize"
                                       AbsoluteLayout.LayoutFlags="PositionProportional" />

                                <!-- Boutons zoom et position (décoratifs pour l'instant) -->
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        BackgroundColor="White"
                                        AbsoluteLayout.LayoutBounds="0.96,0.68,42,42"
                                        AbsoluteLayout.LayoutFlags="PositionProportional">
                                    <Label Text="+" FontSize="26" TextColor="{StaticResource AquaPrimary}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        BackgroundColor="White"
                                        AbsoluteLayout.LayoutBounds="0.96,0.88,42,42"
                                        AbsoluteLayout.LayoutFlags="PositionProportional">
                                    <Image Source="ic_target_teal.svg" WidthRequest="22" HeightRequest="22" />
                                </Border>
                            </AbsoluteLayout>
                        </Grid>
                    </Border>

                    <!-- Légende -->
                    <HorizontalStackLayout Spacing="22" Margin="2,14,0,16">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_water_off_red.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="En cours" FontSize="14" TextColor="{StaticResource AquaMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_check_green.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Eau revenue" FontSize="14" TextColor="{StaticResource AquaMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_target_teal.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Vous" FontSize="14" TextColor="{StaticResource AquaMuted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Fiche de la coupure choisie (pleine largeur, coins hauts arrondis) -->
                <Border StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="0"
                        BackgroundColor="White" Padding="20,10,20,28" MinimumHeightRequest="280">
                    <VerticalStackLayout Spacing="12">
                        <BoxView WidthRequest="44" HeightRequest="5" CornerRadius="3"
                                 Color="{StaticResource AquaBorder}" HorizontalOptions="Center" />

                        <Label x:Name="EmptySheetLabel" Text="Touchez un repère sur la carte pour voir les détails."
                               FontSize="15" TextColor="{StaticResource AquaMuted}" IsVisible="False" />

                        <VerticalStackLayout x:Name="SheetContent" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="SheetBadgeBox" StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0" Padding="10,6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Image x:Name="SheetBadgeIcon" WidthRequest="18" HeightRequest="18"
                                               VerticalOptions="Center" />
                                        <Label x:Name="SheetBadgeLabel" FontSize="14" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label x:Name="SheetConfLabel" Grid.Column="1" FontSize="14"
                                       TextColor="{StaticResource AquaMuted}"
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <Label x:Name="SheetTitle" FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource AquaText}" />
                            <Label x:Name="SheetSub" FontSize="16" TextColor="{StaticResource AquaMuted}" />
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="ic_clock_gray.svg" WidthRequest="20" HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Label x:Name="SheetSince" FontSize="16" TextColor="{StaticResource AquaText}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Voir le détail" Style="{StaticResource LinkLabel}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSeeDetailTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Button x:Name="ConfirmButton" Text="Je constate aussi la coupure"
                                    Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                                    Clicked="OnConfirmClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <views:BottomNavBar Grid.Row="1" Active="CartePage" />
    </Grid>
</ContentPage>